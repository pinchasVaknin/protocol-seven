*.local
.DS_Store

# Local editor/agent tooling. launch.json holds a machine-specific node path.
# settings.json is the exception: it only points the agent at the knowledge
# graph, and does so through `python -m`, so it carries nothing machine-specific.
.claude/*
!.claude/settings.json

# M9: server bundle and harness run artifacts
dist-server/
node-hashes*.json
browser-hashes*.json
harness-*.jsonl
harness-*.err
jitter-*.jsonl
jitter-*.err

# Session reports written beside the repo by the agent. Not part of the build.
Claude outputs/
